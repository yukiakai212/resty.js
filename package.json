{
  "name": "@yukiakai/resty",
  "version": "1.2.1",
  "description": "A minimal, clean, and type-safe HTTP client for REST APIs.",
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "require": "./dist/public.cjs"
    },
    "./adapters/fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "import": "./dist/adapters/fetch.js",
      "require": "./dist/adapters/fetch.cjs"
    },
    "./adapters/got": {
      "types": "./dist/adapters/got.d.ts",
      "import": "./dist/adapters/got.js",
      "require": "./dist/adapters/got.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "npx vitest run --reporter verbose --coverage",
    "format": "prettier --write **/*.{js,ts,json}",
    "format:check": "prettier --check **/*.{js,ts,json}",
    "lint": "eslint src/**/*.ts",
    "typecheck:workspace": "tsc -p tsconfig.workspace.json",
    "generate:types": "npx type-export-builder generate -p src/_public.ts",
    "build:public": "npm run generate:types && tsup --config tsup.public.config.ts",
    "build": "npx tsup",
    "docs": "npx typedoc",
    "prepare:artifact": "tsx workspace/release/prepareArtifact.ts",
    "prepare": "is-ci || husky"
  },
  "files": [
    "dist/*",
    "CHANGELOG.md"
  ],
  "keywords": [
    "http",
    "rest",
    "client",
    "fetch",
    "api",
    "typescript"
  ],
  "author": "Yuki_akai",
  "homepage": "https://github.com/yukiakai212/resty.js",
  "funding": "https://github.com/sponsors/yukiakai212",
  "engines": {
    "node": ">= 16"
  },
  "maintainers": [
    {
      "name": "Yuki_akai",
      "homepage": "https://github.com/yukiakai212"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiakai212/resty.js.git"
  },
  "bugs": {
    "url": "https://github.com/yukiakai212/resty.js/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^4.0.15",
    "@yukiakai/artifact": "^1.0.1",
    "dotenv": "^17.0.1",
    "eslint": "^9.30.0",
    "got": "^14.6.6",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "type-export-builder": "^1.1.0",
    "typedoc": "^0.28.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "got": "^14.6.6"
  },
  "peerDependenciesMeta": {
    "got": {
      "optional": true
    }
  }
}
